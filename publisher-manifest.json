id transparent;border-top:7px solid var(--ink);border-bottom:0;}\n    .a::before{display:none;}\n    section{padding:42px 0;}}\n  @media (max-width:420px){\n    .wrap{padding:0 16px}\n    .timeline{padding-left:22px}\n    .timeline li::before{left:-22px}\n    .client-list li{grid-template-columns:minmax(0,1fr);gap:2px}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-head\">\n        <div>\n          <p class=\"eyebrow\">NETRON · 套餐与使用说明</p>\n          <h1>逸云(NETRON) · 逸云 NETRON<span>先把用量算清楚，再决定买哪一档</span></h1>\n          <p class=\"hero-lead\">这一页只做三件事：把三档套餐的差别摊开写，把开通前后的步骤列清楚，把容易问错的地方先答一遍。价格、流量、设备数都写在正文里，不用去别处对照。</p>\n        </div>\n        <aside class=\"hero-note\">\n          <strong>阅读顺序建议</strong>\n          先看下方时间线里的四步，确认自己处在哪一步；再看套餐对照，最后扫一遍常见问题。年付价格与月付价格分开标注，选之前请以页面展示为准。\n        </aside>\n      </div>\n\n      <ol class=\"timeline\">\n        <li class=\"key\">\n          <span class=\"step-no\">01</span><h3>确认用量与设备数</h3>\n          <p>统计同时在线的设备有多少台、每月大概跑多少流量。这一步决定你在基础版、旗舰版、团队版之间落在哪一档。</p>\n        </li>\n        <li>\n          <span class=\"step-no\">02</span><h3>选套餐，按月付或按年付</h3>\n          <p>三档都提供月付与年付两种周期，年付价格单独列出。先按短期周期试一轮，用量确认稳定后再考虑年付。</p>\n        </li>\n        <li>\n          <span class=\"step-no\">03</span><h3>在客户端完成设置</h3>\n          <p>按设备类型选对应客户端，把订阅信息与登录凭据按客户端提示填入。具体入口以客户端实际界面为准。</p>\n        </li>\n        <li>\n          <span class=\"step-no\">04</span><h3>用量观察与调整</h3>\n          <p>运行一段时间后看用量是否贴合预判。偏少可下移一档，偏紧则上移，团队版还提供定制路由的沟通空间。</p>\n        </li>\n      </ol>\n\n      <p class=\"jump\">\n        区块跳转：\n        <a href=\"#plans\">套餐对照</a>\n        <a href=\"#clients\">客户端与步骤</a>\n        <a href=\"#faq\">常见问题</a>\n      </p>\n    </div>\n  </header>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <h2>三档套餐，两栏对照</h2>\n      <p class=\"sec-sub\">左侧是基础版与旗舰版的正面对照，右侧单独列出团队版的权益。旗舰版为推荐档位，标记在卡片左上角。流量、设备数、线路与支持方式按档位递增，价格同步递增。</p>\n\n      <div class=\"plans\">\n        <div>\n          <article class=\"plan\">\n            <span class=\"plan-tag\">基础版</span>\n            <h3>基础版</h3>\n            <p class=\"price\">¥15<small> / 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥150/年</p>\n            <ul>\n              <li>每月 100GB 流量额度</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <p class=\"plan-foot\">适合设备少、用量可预估的个人使用场景。</p>\n          </article>\n\n          <article class=\"plan recommended\">\n            <span class=\"plan-tag\">推荐 · 旗舰版</span>\n            <h3>旗舰版</h3>\n            <p class=\"price\">¥35<small> / 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥350/年</p>\n            <ul>\n              <li>每月 300GB 流量额度</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n            <p class=\"plan-foot\">设备数量与流量都在中间区间时，这一档的匹配度最高。</p>\n          </article>\n        </div>\n\n        <div>\n          <article class=\"plan\">\n            <span class=\"plan-tag\">团队版</span>\n            <h3>团队版</h3>\n            <p class=\"price\">¥85<small> / 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥850/年</p>\n            <ul>\n              <li>每月 1000GB 流量额度</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <p class=\"plan-foot\">多人共用、设备数集中或需要定制路由沟通时选这一档。</p>\n          </article>\n\n          <div class=\"team-note\">\n            <h3>团队版需要提前准备的几件事</h3>\n            <ul>\n              <li>同时在线设备的清单与大致数量</li>\n              <li>每月流量规模的经验值或估算区间</li>\n              <li>是否需要定制路由，以及用途方向</li>\n              <li>对接人与沟通方式</li>\n              <li>希望生效的时间点</li>\n              <li>是否需要多个独立账户分开管理</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"table-wrap\">\n        <table>\n          三档套餐关键项横向对照，便于逐项比较\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th>旗舰版</th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td>¥15 / 月</td>\n              <td>¥35 / 月</td>\n              <td>¥85 / 月</td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150 / 年</td>\n              <td>¥350 / 年</td>\n              <td>¥850 / 年</td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td>300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>基础流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n              <td>含 VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>线路与优化</th>\n              <td>普通线路节点池</td>\n              <td>IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>标准工单</td>\n              <td>7x24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <h2>客户端与开通步骤</h2>\n      <p class=\"sec-sub\">下面按设备类型列出可选的客户端方向，以及从下单到日常使用的步骤。安装包与订阅地址以购买后提供的说明为准，本页不提供直接下载链接。</p>\n\n      <div class=\"use-grid\">\n        <div class=\"ticket\">\n          <h3>四步完成开通</h3>\n          <ol>\n            <li>确定档位与计费周期，记录好所选套餐的名称、流量与设备上限。</li>\n            <li>获取账户信息与订阅凭据，连同有效期一起保存到你自己的记录里。</li>\n            <li>在对应客户端中填入订阅信息并保存，确认登录状态正常。</li>\n            <li>先用一台设备跑通，再按套餐允许的设备数逐台添加，避免超出上限。</li>\n          </ol>\n        </div>\n\n        <div class=\"ticket\">\n          <h3>按设备选择客户端方向</h3>\n          <ul class=\"client-list\">\n            <li><b>桌面端</b><span>在电脑上按客户端提示导入订阅，先确认连接状态，再调整线路。</span></li>\n            <li><b>移动端</b><span>手机与平板使用对应客户端，注意同一账户的设备计入同时在线上限。</span></li>\n            <li><b>多设备共用</b><span>按套餐设备数分配，超出上限时优先保留常用设备。</span></li>\n            <li><b>团队场景</b><span>团队版建议先整理设备清单，再决定是否拆分为多个账户。</span></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <h2>常见问题</h2>\n      <p class=\"sec-sub\">问题按主题分成三组：套餐与计费、客户端与设备、用量与支持。每条都给出明确答案，读完仍有疑问可通过工单沟通。</p>\n\n      <div class=\"faq-group\">\n        <h3>套餐与计费</h3>\n\n        <div class=\"qa\">\n          <p class=\"q\">月付和年付的差别只体现在价格上吗？</p>\n          <p class=\"a\">页面展示的差别是价格与计费周期：基础版 ¥15/月、年付 ¥150；旗舰版 ¥35/月、年付 ¥350；团队版 ¥85/月、年付 ¥850。年付对应的是按年一次性结算，流量与设备数等权益与同档月付保持一致。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">旗舰版被标为推荐，是因为它更快吗？</p>\n          <p class=\"a\">推荐标记说明的是匹配度，不是速度承诺。旗舰版处在三档中间：300GB 流量、5 台设备、全节点原生流媒体解锁与 IPLC 专线游戏加速优化。多数个人用户的用量落在这个区间，所以标为推荐。若你的用量明显低于或高于这个区间，上下两档更合适。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">团队版和旗舰版在支持上有什么不同？</p>\n          <p class=\"a\">旗舰版提供 7x24 优先工单支持；团队版在此之外增加专属客户经理服务，并支持企业定制路由。团队版还提供 VIP 专属高带宽节点与 20 台设备同时在线的额度。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">可以先选一个短期周期再换档吗？</p>\n          <p class=\"a\">建议先按月付跑一轮，观察实际用量与设备数量，再决定是否上移或下移档位。具体换档规则以购买时展示的说明为准，本页不额外承诺。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>客户端与设备</h3>\n\n        <div class=\"qa\">\n          <p class=\"q\">同时在线的设备数是怎么计算的？</p>\n          <p class=\"a\">按同一时间处于连接状态的设备数量计算：基础版 3 台、旗舰版 5 台、团队版 20 台。手机、平板、电脑都计入其中，不区分设备类型。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">换设备时需要先做什么？</p>\n          <p class=\"a\">建议先在旧设备上断开连接，再在新设备上添加，保持同时在线数量不超上限。若设备数量接近上限，优先保留常用设备，其余按需切换。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">本页能直接下载客户端吗？</p>\n          <p class=\"a\">不能。本页只说明客户端方向与步骤，不提供安装包或订阅地址。实际的客户端信息与配置入口以购买后提供的说明为准。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">团队版一定要拆分账户吗？</p>\n          <p class=\"a\">不一定。团队版本身提供 20 台设备同时在线的额度，可以集中在一个账户下管理；如果团队内部希望分开结算或分开管理，也可以先整理设备清单与用途，再与客户经理沟通账户划分方式。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>用量与支持</h3>\n\n        <div class=\"qa\">\n          <p class=\"q\">怎么判断自己该选哪一档流量？</p>\n          <p class=\"a\">用一个月作参考：只做网页、邮件、即时通讯，基础版的 100GB 通常够用；经常看视频或长时间在线办公，旗舰版 300GB 留出的余量更从容；多人共用或设备集中，团队版 1000GB 对应更高总量。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">流量用完了会怎样？</p>\n          <p class=\"a\">本页只列出各档每月的流量额度，不额外描述用完后的处理方式。额度与周期请以下单时展示的说明为准；如果你希望提前留出余量，可在预估用量基础上上移一档。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">遇到问题通过什么渠道反馈？</p>\n          <p class=\"a\">通过工单反馈。旗舰版为 7x24 优先工单支持，团队版由专属客户经理对接。反馈时把套餐名称、设备类型、问题出现的时间与现象一起写明，能减少来回确认的次数。</p>\n        </div>\n\n        <div class=\"qa\">\n          <p class=\"q\">本页的价格与权益会变吗？</p>\n          <p class=\"a\">页面展示的是当前写明的价格与权益，实际以下单时展示的内容为准。如对某一项权益有疑问，建议在下单前通过工单确认，避免后续理解不一致。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p class=\"brand\">逸云 NETRON</p>\n    <p>本页用于说明三档套餐的价格、流量、设备数与支持方式，以及开通步骤、客户端方向与常见问题。页面不提供安装包、订阅地址或支付入口。</p>\n    <p>价格与权益以下单时展示的内容为准；如与页面描述存在差异，请通过工单确认后再决定。</p>\n    <ul class=\"foot-links\">\n      <li><a href=\"#plans\">回到套餐对照</a></li>\n      <li><a href=\"#clients\">回到客户端与步骤</a></li>\n      <li><a href=\"#faq\">回到常见问题</a></li>\n    </ul>\n  </div>\n</footer>",
